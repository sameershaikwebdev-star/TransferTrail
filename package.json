{
  "name": "balance-vault",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=24.0.0 <25", "npm": ">=10 <12" },
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run db:generate -w apps/api && npm run build -w apps/web",
    "start": "npm run start -w apps/api",
    "test": "npm test -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:studio": "npm run db:studio -w apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
