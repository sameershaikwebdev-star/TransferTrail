NODE_ENV=development
API_PORT=3001
PORT=3001
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_READY_TIMEOUT_MS=1500
REDIS_URL=redis://127.0.0.1:6379/0

# Runtime login must be a non-superuser member of balancevault_runtime only.
# Keep this credential separate from migration credentials.
DATABASE_URL=

# Separate read-only login for credential verification. It inherits only
# balancevault_auth_runtime and is never used for ordinary API queries.
AUTH_DATABASE_URL=

# Supply only to the migration pipeline. Never configure it on the API service.
MIGRATION_DATABASE_URL=

# Supply only for the one-time first-admin CLI. This login must be granted
# balancevault_bootstrap_operator and must not be used by the running API.
BALANCEVAULT_BOOTSTRAP_DATABASE_URL=

# Generate with: openssl rand -base64 48. Use a secret manager in production.
JWT_ACCESS_SECRET=

# Shared between the API signer and the protected PostgreSQL key row.
# Generate once with: openssl rand -hex 32. Never log or commit the value.
BALANCEVAULT_ACTOR_ASSERTION_KEY=

# Optional operations-only ledger reconciliation; use a non-superuser login
# that inherits only balancevault_runtime. The command opens a read-only snapshot.
RECONCILIATION_DATABASE_URL=
